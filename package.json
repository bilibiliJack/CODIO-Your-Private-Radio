{
  "name": "codio-private-radio",
  "version": "0.1.7",
  "private": true,
  "license": "MIT",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n WEB,VOICE \"npm:dev:web\" \"npm:voice\"",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "desktop": "electron .",
    "desktop:launch": "wait-on http-get://127.0.0.1:3000 && cross-env CODIO_URL=http://127.0.0.1:3000 electron .",
    "desktop:dev": "concurrently -k -n WEB,VOICE,DESKTOP \"npm:dev:web\" \"npm:voice\" \"npm:desktop:launch\"",
    "desktop:server": "node desktop/prepare-server.cjs",
    "desktop:build": "npm run build && npm run desktop:server && electron-builder --win nsis --publish never",
    "voice": "node voice-engine/server.cjs",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "build": {
    "appId": "com.codio.private.radio",
    "productName": "CODIO",
    "protocols": [
      {
        "name": "CODIO",
        "schemes": [
          "codio"
        ]
      }
    ],
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "desktop/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/codio-server",
        "to": "codio-server"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CODIO-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "geist": "^1.7.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sherpa-onnx-node": "^1.13.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wait-on": "^9.0.3",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
